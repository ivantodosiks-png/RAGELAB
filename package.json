{
  "name": "ragelab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RAGELAB - browser multiplayer sandbox FPS (Three.js + Rapier + authoritative Node server + Supabase)",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace @ragelab/server",
    "dev:client": "npm run dev --workspace @ragelab/client",
    "build": "npm run build --workspace @ragelab/shared && npm run build --workspace @ragelab/server && npm run build --workspace @ragelab/client",
    "build:shared": "npm run build --workspace @ragelab/shared",
    "build:server": "npm run build --workspace @ragelab/server",
    "build:client": "npm run build --workspace @ragelab/client",
    "build:vercel": "npm run build:client",
    "start": "npm run start --workspace @ragelab/server",
    "preview": "npm run preview --workspace @ragelab/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "node scripts/migrate.mjs",
    "db:introspect": "node scripts/introspect-db.mjs",
    "clean": "node -e \"const {rmSync}=require('fs');for(const p of ['shared/dist','server/dist','client/dist'])rmSync(p,{recursive:true,force:true})\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "typescript": "^5.7.3"
  },
  "main": "index.js",
  "dependencies": {
    "ansi-regex": "^5.0.1",
    "ansi-styles": "^4.3.0",
    "chalk": "^4.1.2",
    "cliui": "^8.0.1",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "emoji-regex": "^8.0.0",
    "esbuild": "^0.25.12",
    "escalade": "^3.2.0",
    "fdir": "^6.5.0",
    "fflate": "^0.8.3",
    "get-caller-file": "^2.0.5",
    "has-flag": "^4.0.0",
    "iceberg-js": "^0.8.1",
    "is-fullwidth-code-point": "^3.0.0",
    "meshoptimizer": "^0.18.1",
    "nanoid": "^3.3.18",
    "pg-cloudflare": "^1.4.0",
    "pg-connection-string": "^2.14.0",
    "pg-int8": "^1.0.1",
    "pg-pool": "^3.14.0",
    "pg-protocol": "^1.16.0",
    "pg-types": "^2.2.0",
    "pgpass": "^1.0.5",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.26",
    "postgres-array": "^2.0.0",
    "postgres-bytea": "^1.0.1",
    "postgres-date": "^1.0.7",
    "postgres-interval": "^1.2.0",
    "require-directory": "^2.1.1",
    "rollup": "^4.63.1",
    "rxjs": "^7.8.2",
    "shell-quote": "^1.9.0",
    "source-map-js": "^1.2.1",
    "split2": "^4.2.0",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "supports-color": "^8.1.1",
    "three": "^0.172.0",
    "tinyglobby": "^0.2.17",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "undici-types": "^6.21.0",
    "vite": "^6.4.3",
    "wrap-ansi": "^7.0.0",
    "ws": "^8.21.3",
    "xtend": "^4.0.2",
    "y18n": "^5.0.8",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivantodosiks-png/RAGELAB.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ivantodosiks-png/RAGELAB/issues"
  },
  "homepage": "https://github.com/ivantodosiks-png/RAGELAB#readme"
}
