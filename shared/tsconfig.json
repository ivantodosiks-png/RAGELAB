{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "types": [],
    // TextEncoder/TextDecoder + typed arrays exist in both runtimes; DOM is the
    // only lib that declares them without pulling in @types/node.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts"]
}
