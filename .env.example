# ─────────────────────────────────────────────────────────────────────────────
# RAGELAB environment configuration
#
# Copy this file to `.env` and fill in the values from your Supabase project
# dashboard (Project Settings -> API / Database).
#
# NEVER commit `.env`. Only variables prefixed with VITE_ or NEXT_PUBLIC_ are
# exposed to the browser bundle; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase: public values (safe for the browser) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=

# ── Supabase: privileged values (server-only, never sent to the client) ──────
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# ── Postgres direct connection (used only by the migration runner) ───────────
POSTGRES_DATABASE=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# ── Game server ──────────────────────────────────────────────────────────────
GAME_SERVER_PORT=8080
GAME_SERVER_HOST=0.0.0.0
GAME_SERVER_NAME=RAGELAB Local Server
GAME_SERVER_REGION=local
GAME_SERVER_TICK_RATE=60
GAME_SERVER_SNAPSHOT_RATE=20
GAME_SERVER_MAX_PLAYERS_PER_ROOM=16
# Comma separated list of origins allowed to open a websocket. "*" for dev.
GAME_SERVER_ALLOWED_ORIGINS=*
# Set to "true" to allow unauthenticated guest players (handy for local tests).
GAME_SERVER_ALLOW_GUESTS=true
# Set to "true" to mirror room state into Supabase for the server browser.
GAME_SERVER_PERSIST=true
# Open a public tunnel so friends on other networks can join this PC.
# Set to "false" for LAN-only. Requires outbound HTTPS (downloads cloudflared once).
GAME_SERVER_PUBLIC_TUNNEL=true
# Optional override if you already have a public websocket URL (skip the tunnel).
# GAME_SERVER_PUBLIC_WS_URL=wss://your-host.example
# Hosted Node (Railway/Fly) should set GAME_SERVER_PUBLIC_TUNNEL=false and
# GAME_SERVER_PUBLIC_WS_URL=wss://your-app.example — then the website can
# Create lobby without npm run dev.
LOG_LEVEL=info

# ── Client (Vite) ────────────────────────────────────────────────────────────
# Public URL of the game server websocket, e.g. ws://localhost:8080
# For the live website, set this to the same public wss:// as GAME_SERVER_PUBLIC_WS_URL.
VITE_GAME_SERVER_URL=ws://localhost:8080
# Public HTTP URL of the game server (server browser / health checks / lobby lookup)
VITE_GAME_SERVER_HTTP_URL=http://localhost:8080
# These mirror the NEXT_PUBLIC_* values above; the Vite config will fall back to
# NEXT_PUBLIC_* automatically, so you normally do not need to set them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated emails that receive the Admin panel (server + db:migrate).
# RAGELAB_ADMIN_EMAILS=you@example.com

